# 服务端口
PORT=3000

# Elasticsearch 配置
ES_HOST=http://localhost:9200
ES_USER=elastic
ES_PASSWORD=changeme
ES_INDEX=slow_queries

# MySQL 配置
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=root
MYSQL_DATABASE=mysql
MYSQL_SLOW_QUERY_TABLE=slow_log
MYSQL_LONG_QUERY_TIME=1

# PostgreSQL 配置
PG_HOST=localhost
PG_PORT=5432
PG_USER=postgres
PG_PASSWORD=postgres
PG_DATABASE=postgres
PG_LOG_DIRECTORY=/var/log/postgresql

# 采集配置
COLLECT_INTERVAL=60000
COLLECT_LIMIT=1000
